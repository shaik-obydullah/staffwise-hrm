{% import '_macros.html.twig' as ui %}
<!DOCTYPE html>
<html lang="en-GB">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}StaffWise HRM{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
{% set route = app.request.attributes.get('_route') %}
<div class="app">
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-mark">SW</div>
            <div>
                <div class="brand-name">StaffWise</div>
                <div class="brand-sub">UK HR &amp; Payroll</div>
            </div>
        </div>

        <nav class="nav">
            <div class="nav-section">Overview</div>
            <a href="{{ path('app_dashboard') }}" class="{{ route == 'app_dashboard' ? 'active' }}"><span class="nav-icon">◫</span> Dashboard</a>

            <div class="nav-section">Workforce</div>
            <a href="{{ path('app_employees') }}" class="{{ route starts with 'app_employee' ? 'active' }}"><span class="nav-icon">👥</span> Employees</a>
            <a href="{{ path('app_holidays') }}" class="{{ route starts with 'app_holiday' ? 'active' }}"><span class="nav-icon">🌴</span> Holidays</a>

            <div class="nav-section">Payroll</div>
            <a href="{{ path('app_payroll_index') }}" class="{{ route starts with 'app_payroll' ? 'active' }}"><span class="nav-icon">£</span> Payroll runs</a>
            <a href="{{ path('app_hmrc_index') }}" class="{{ route starts with 'app_hmrc' ? 'active' }}"><span class="nav-icon">🏛</span> HMRC liabilities</a>
            <a href="{{ path('app_tax_years') }}" class="{{ route starts with 'app_tax_year' ? 'active' }}"><span class="nav-icon">%</span> Tax &amp; rates</a>

            <div class="nav-section">Administration</div>
            <a href="{{ path('app_settings') }}" class="{{ route == 'app_settings' ? 'active' }}"><span class="nav-icon">⚙</span> Settings</a>
            <a href="{{ path('app_audit') }}" class="{{ route == 'app_audit' ? 'active' }}"><span class="nav-icon">≡</span> Audit trail</a>
        </nav>

        <div class="sidebar-footer">
            <div class="admin">{{ app.user ? app.user.userIdentifier : 'Administrator' }}</div>
            <a href="{{ path('app_settings') }}">Settings</a>
            <a href="{{ path('app_lock') }}">Lock</a>
            <a href="{{ path('app_logout') }}">Sign out</a>
        </div>
    </aside>

    <div class="main">
        <header class="topbar">
            <div>
                <h1 class="page-title">{% block page_title %}Dashboard{% endblock %}</h1>
                <div class="page-subtitle">{% block page_subtitle %}{% endblock %}</div>
            </div>
            <div class="topbar-actions">{% block topbar_actions %}{% endblock %}</div>
        </header>

        <main class="content">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash flash-{{ type }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block content %}{% endblock %}
        </main>
    </div>
</div>
{% block javascripts %}{% endblock %}
</body>
</html>
