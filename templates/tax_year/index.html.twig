{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as ui %}

{% block title %}Tax &amp; rates · StaffWise HRM{% endblock %}
{% block page_title %}Tax years &amp; statutory rates{% endblock %}
{% block page_subtitle %}Effective-dated UK PAYE, NI, pension and holiday rules{% endblock %}

{% block topbar_actions %}
    <a class="btn btn-primary" href="{{ path('app_tax_year_new') }}">New tax year</a>
{% endblock %}

{% block content %}
    <div class="card">
        {% if taxYears|length == 0 %}
            <div class="empty">
                <strong>No tax year rates configured</strong>
                Create a tax year before processing payroll.
                <div class="mt-3"><a class="btn btn-primary btn-sm" href="{{ path('app_tax_year_new') }}">Create tax year</a></div>
            </div>
        {% else %}
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Tax year</th>
                            <th>Effective period</th>
                            <th>Status</th>
                            <th class="num">Personal allowance</th>
                            <th class="num">Basic / higher</th>
                            <th class="num">Employee NI</th>
                            <th class="num">Employer NI</th>
                            <th class="num">Employment Allowance</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for taxYear in taxYears %}
                            <tr>
                                <td><a class="table-link" href="{{ path('app_tax_year_edit', {id: taxYear.id}) }}">{{ taxYear.name }}</a></td>
                                <td class="small nowrap">{{ taxYear.effectiveFrom ? taxYear.effectiveFrom|date('j M Y') : '—' }} – {{ taxYear.effectiveTo ? taxYear.effectiveTo|date('j M Y') : '—' }}</td>
                                <td>{{ taxYear.active ? '<span class="badge badge-green">Active</span>'|raw : '<span class="badge">Inactive</span>'|raw }}</td>
                                <td class="num">{{ ui.money(taxYear.personalAllowance) }}</td>
                                <td class="num">{{ taxYear.basicRate|number_format(2) }}% / {{ taxYear.higherRate|number_format(2) }}%</td>
                                <td class="num">{{ taxYear.niEmployeeRate|number_format(2) }}%</td>
                                <td class="num">{{ taxYear.niEmployerRate|number_format(2) }}%</td>
                                <td class="num">{{ ui.money(taxYear.employmentAllowance) }}</td>
                                <td class="right nowrap">
                                    <a class="btn btn-outline btn-sm" href="{{ path('app_tax_year_edit', {id: taxYear.id}) }}">Edit</a>
                                    {% if not taxYear.active %}
                                        <form method="post" action="{{ path('app_tax_year_activate', {id: taxYear.id}) }}" style="display:inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('activate_tax_year_' ~ taxYear.id) }}">
                                            <button class="btn btn-teal btn-sm" type="submit">Activate</button>
                                        </form>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>

    <div class="notice mt-4">
        Rates are versioned by effective date. Activating a tax year never changes finalised payroll; new runs use the active configuration. Each activation is recorded in the audit trail.
    </div>
{% endblock %}
