{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as ui %}

{% block title %}Payroll · StaffWise HRM{% endblock %}
{% block page_title %}Payroll runs{% endblock %}
{% block page_subtitle %}Weekly and monthly payroll processing{% endblock %}

{% block topbar_actions %}
    <a class="btn btn-primary" href="{{ path('app_payroll_new') }}">New payroll run</a>
{% endblock %}

{% block content %}
    <div class="card">
        {% if runs|length == 0 %}
            <div class="empty">
                <strong>No payroll runs yet</strong>
                Start a run to calculate gross pay, PAYE, National Insurance, pension, student loans and net pay.
                <div class="mt-3"><a class="btn btn-primary btn-sm" href="{{ path('app_payroll_new') }}">Start payroll</a></div>
            </div>
        {% else %}
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Pay date</th>
                            <th>Period</th>
                            <th>Frequency</th>
                            <th>Tax year</th>
                            <th>Status</th>
                            <th class="num">Employees</th>
                            <th class="num">Gross</th>
                            <th class="num">Net</th>
                            <th class="num">HMRC</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for run in runs %}
                            <tr>
                                <td class="nowrap"><a class="table-link" href="{{ path('app_payroll_show', {id: run.id}) }}">{{ run.payDate ? run.payDate|date('j M Y') : '—' }}</a></td>
                                <td class="small muted nowrap">{{ run.periodStart ? run.periodStart|date('j M') : '' }} – {{ run.periodEnd ? run.periodEnd|date('j M Y') : '' }}</td>
                                <td class="small">{{ run.frequency|capitalize }}</td>
                                <td class="small">{{ run.taxYear ? run.taxYear.name : '—' }}</td>
                                <td>{{ ui.status_badge(run.status) }}</td>
                                <td class="num">{{ run.payslips|length }}</td>
                                <td class="num">{{ ui.money(run.grossTotal) }}</td>
                                <td class="num">{{ ui.money(run.netTotal) }}</td>
                                <td class="num">{{ ui.money(run.hmrcLiabilityTotal) }}</td>
                                <td class="right nowrap">
                                    <a class="btn btn-outline btn-sm" href="{{ path('app_payroll_show', {id: run.id}) }}">Open</a>
                                    {% if run.finalised %}
                                        <a class="btn btn-outline btn-sm" href="{{ path('app_hmrc_show', {id: run.id}) }}">HMRC</a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}
