{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as ui %}

{% block title %}HMRC liabilities · StaffWise HRM{% endblock %}
{% block page_title %}HMRC liabilities{% endblock %}
{% block page_subtitle %}PAYE, National Insurance, student loans and Employment Allowance{% endblock %}

{% block content %}
    <div class="card mb-2">
        <div class="card-header" style="margin-bottom:0">
            <div class="employee-cell">
                <div class="avatar avatar-lg" style="background:var(--amber-soft);color:var(--amber)">🏛</div>
                <div>
                    <div class="muted small">Total reported liability across finalised payroll</div>
                    <div style="font-size:28px;font-weight:750">{{ ui.money(totalLiability) }}</div>
                </div>
            </div>
            <div class="right small muted">
                Employer NI is shown after Employment Allowance.<br>
                Student loan deductions are included in the HMRC total.
            </div>
        </div>
    </div>

    {% if runs|length == 0 %}
        <div class="card">
            <div class="empty">
                <strong>No finalised payroll yet</strong>
                Finalise a payroll run to calculate your PAYE, NI and student loan liability.
                <div class="mt-3"><a class="btn btn-primary btn-sm" href="{{ path('app_payroll_new') }}">Start payroll</a></div>
            </div>
        </div>
    {% else %}
        <div class="grid">
            {% for summary in taxYearSummaries %}
                <div class="card">
                    <div class="card-header">
                        <div>
                            <h3 class="card-title">Tax year {{ summary.taxYear.name }}</h3>
                            <div class="card-sub">{{ summary.runs|length }} finalised {{ summary.runs|length == 1 ? 'run' : 'runs' }}</div>
                        </div>
                        <div class="right">
                            <div class="muted small">Total liability</div>
                            <div style="font-size:21px;font-weight:750">{{ ui.money(summary.total) }}</div>
                        </div>
                    </div>

                    <div class="tiles mb-2">
                        <div class="tile"><div class="tile-label">PAYE</div><div class="tile-value" style="font-size:16px">{{ ui.money(summary.paye) }}</div></div>
                        <div class="tile"><div class="tile-label">Employee NI</div><div class="tile-value" style="font-size:16px">{{ ui.money(summary.employeeNi) }}</div></div>
                        <div class="tile"><div class="tile-label">Employer NI</div><div class="tile-value" style="font-size:16px">{{ ui.money(summary.employerNi) }}</div></div>
                        <div class="tile"><div class="tile-label">Employment Allowance</div><div class="tile-value" style="font-size:16px">−{{ ui.money(summary.allowance) }}</div></div>
                        <div class="tile"><div class="tile-label">Student loans</div><div class="tile-value" style="font-size:16px">{{ ui.money(summary.studentLoan) }}</div></div>
                    </div>

                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Pay date</th>
                                    <th>Reference</th>
                                    <th class="num">PAYE</th>
                                    <th class="num">NI</th>
                                    <th class="num">Student loan</th>
                                    <th class="num">Total</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for run in summary.runs %}
                                    <tr>
                                        <td class="nowrap">{{ run.payDate ? run.payDate|date('j M Y') : '—' }}</td>
                                        <td class="mono small">{{ run.paymentReference }}</td>
                                        <td class="num">{{ ui.money(run.payeTotal) }}</td>
                                        <td class="num">{{ ui.money(run.employeeNiTotal + run.employerNiTotal - run.employmentAllowanceApplied) }}</td>
                                        <td class="num">{{ ui.money(run.studentLoanTotal) }}</td>
                                        <td class="num"><strong>{{ ui.money(run.hmrcLiabilityTotal) }}</strong></td>
                                        <td class="right"><a class="btn btn-outline btn-sm" href="{{ path('app_hmrc_show', {id: run.id}) }}">Details</a></td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
